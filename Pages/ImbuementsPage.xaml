<Page x:Class="ADCoins.Pages.ImbuementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#121212">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <!-- ================================= -->
            <!-- TÍTULO -->
            <!-- ================================= -->

            <TextBlock Text="Imbuements"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Configure seus equipamentos e compare os custos dos imbuements."
                       FontSize="15"
                       Foreground="#888888"
                       Margin="0,8,0,25"/>


            <!-- ================================= -->
            <!-- VALORES DOS TOKENS -->
            <!-- ================================= -->

            <Border Background="#1B1B1B"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,30">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Valores dos Tokens"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock Text="Informe o valor atual no Market."
                                   Foreground="#888888"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- GOLD TOKEN -->

                    <StackPanel Grid.Column="1"
                                Margin="10,0">

                        <TextBlock Text="Gold Token"
                                   Foreground="#CCCCCC"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="GoldTokenInput"
                                 Height="42"
                                 Text="57000"
                                 Background="#252525"
                                 Foreground="White"
                                 BorderBrush="#3A3A3A"
                                 Padding="10"
                                 FontSize="15"/>

                    </StackPanel>


                    <!-- SILVER TOKEN -->

                    <StackPanel Grid.Column="2"
                                Margin="10,0">

                        <TextBlock Text="Silver Token"
                                   Foreground="#CCCCCC"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="SilverTokenInput"
                                 Height="42"
                                 Text="64500"
                                 Background="#252525"
                                 Foreground="White"
                                 BorderBrush="#3A3A3A"
                                 Padding="10"
                                 FontSize="15"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================= -->
            <!-- TÍTULO EQUIPAMENTOS -->
            <!-- ================================= -->

            <TextBlock Text="Equipamentos"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>


            <!-- ================================= -->
            <!-- INVENTÁRIO -->
            <!-- ================================= -->

            <Grid HorizontalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="125"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="125"/>
                    <RowDefinition Height="125"/>
                    <RowDefinition Height="125"/>
                    <RowDefinition Height="125"/>
                </Grid.RowDefinitions>


                <!-- ================================= -->
                <!-- COLUNA 1 -->
                <!-- ================================= -->


                <!-- AMULET -->

                <Button x:Name="AmuletButton"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="5"
                        Background="#1B1B1B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        Click="EquipmentButton_Click"
                        Tag="Amulet">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="💎"
                                   FontSize="38"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Amulet"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="1 slot"
                                   FontSize="12"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- WEAPON -->

                <Button x:Name="WeaponButton"
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="5"
                        Background="#1B1B1B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        Click="EquipmentButton_Click"
                        Tag="Weapon">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="⚔"
                                   FontSize="38"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Weapon"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="3 slots"
                                   FontSize="12"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- RING -->

                <Button x:Name="RingButton"
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="5"
                        Background="#1B1B1B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        Click="EquipmentButton_Click"
                        Tag="Ring">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="💍"
                                   FontSize="38"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Ring"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="1 slot"
                                   FontSize="12"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- ================================= -->
                <!-- COLUNA 2 -->
                <!-- ================================= -->


                <!-- HELMET -->

                <Button x:Name="HelmetButton"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        Background="#1B1B1B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        Click="EquipmentButton_Click"
                        Tag="Helmet">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="⛑"
                                   FontSize="38"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Helmet"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="2 slots"
                                   FontSize="12"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- ARMOR -->

                <Button x:Name="ArmorButton"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        Background="#1B1B1B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        Click="EquipmentButton_Click"
                        Tag="Armor">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="🛡"
                                   FontSize="38"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Armor"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="3 slots"
                                   FontSize="12"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- LEGS -->

                <Button x:Name="LegsButton"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="5"
                        Background="#1B1B1B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        Click="EquipmentButton_Click"
                        Tag="Legs">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="👖"
                                   FontSize="38"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Legs"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="Sem slot"
                                   FontSize="12"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- BOOTS -->

                <Button x:Name="BootsButton"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="5"
                        Background="#1B1B1B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        Click="EquipmentButton_Click"
                        Tag="Boots">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="👢"
                                   FontSize="38"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Boots"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="1 slot"
                                   FontSize="12"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- ================================= -->
                <!-- COLUNA 3 -->
                <!-- ================================= -->


                <!-- BACKPACK -->

                <Button x:Name="BackpackButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="5"
                        Background="#1B1B1B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        Click="EquipmentButton_Click"
                        Tag="Backpack">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="🎒"
                                   FontSize="38"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Backpack"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="1 slot"
                                   FontSize="12"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- SHIELD -->

                <Button x:Name="ShieldButton"
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="5"
                        Background="#1B1B1B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        Click="EquipmentButton_Click"
                        Tag="Shield">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="🛡"
                                   FontSize="38"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Shield"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="1 slot"
                                   FontSize="12"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>


                <!-- TRINKET -->

                <Button x:Name="TrinketButton"
                        Grid.Row="3"
                        Grid.Column="2"
                        Margin="5"
                        Background="#1B1B1B"
                        BorderBrush="#353535"
                        BorderThickness="1"
                        Click="EquipmentButton_Click"
                        Tag="Trinket">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="🪄"
                                   FontSize="38"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Trinket"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="1 slot"
                                   FontSize="12"
                                   Foreground="#888888"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </Grid>


            <!-- ================================= -->
            <!-- COMPARAÇÃO -->
            <!-- ================================= -->

            <Border Margin="0,30,0,20"
                    Background="#1B1B1B"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock x:Name="SelectedEquipmentText"
                               Text="Nenhum equipamento selecionado"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock x:Name="SelectedEquipmentDescription"
                               Text="Selecione um equipamento acima para configurar seus imbuements."
                               Foreground="#888888"
                               Margin="0,5,0,15"/>


                    <!-- ÁREA DOS SLOTS -->

                    <StackPanel x:Name="SlotsPanel"
            Margin="0,10,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Page>