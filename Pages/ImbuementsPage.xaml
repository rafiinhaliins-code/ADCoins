<Page x:Class="ADCoins.Pages.ImbuementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#121212">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <!-- ================================= -->
            <!-- TÍTULO -->
            <!-- ================================= -->

            <TextBlock Text="Imbuements"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Configure seus equipamentos e compare os custos dos imbuements."
                       FontSize="15"
                       Foreground="#888888"
                       Margin="0,8,0,25"/>


            <!-- ================================= -->
            <!-- VALORES DOS TOKENS -->
            <!-- ================================= -->

            <Border Background="#1B1B1B"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,30">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>


                    <!-- DESCRIÇÃO -->

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Valores dos Tokens"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <TextBlock Text="Informe o valor atual no Market."
                                   Foreground="#888888"
                                   Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- GOLD TOKEN -->

                    <StackPanel Grid.Column="1"
                                Margin="10,0">

                        <TextBlock Text="Gold Token"
                                   Foreground="#CCCCCC"
                                   Margin="0,0,0,7"/>

                        <TextBox Height="42"
                                 Text="57000"
                                 Background="#252525"
                                 Foreground="White"
                                 BorderBrush="#3A3A3A"
                                 Padding="10"
                                 FontSize="15"/>

                    </StackPanel>


                    <!-- SILVER TOKEN -->

                    <StackPanel Grid.Column="2"
                                Margin="10,0">

                        <TextBlock Text="Silver Token"
                                   Foreground="#CCCCCC"
                                   Margin="0,0,0,7"/>

                        <TextBox Height="42"
                                 Text="64500"
                                 Background="#252525"
                                 Foreground="White"
                                 BorderBrush="#3A3A3A"
                                 Padding="10"
                                 FontSize="15"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================= -->
            <!-- TÍTULO EQUIPAMENTOS -->
            <!-- ================================= -->

            <TextBlock Text="Equipamentos"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>


            <!-- ================================= -->
            <!-- INVENTÁRIO -->
            <!-- ================================= -->

            <!-- ================================= -->
            <!-- INVENTÁRIO DO PERSONAGEM -->
            <!-- ================================= -->

            <Grid HorizontalAlignment="Center">

                <!-- 3 COLUNAS -->

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="125"/>
                </Grid.ColumnDefinitions>

                <!-- 4 SLOTS VERTICAIS -->

                <Grid.RowDefinitions>
                    <RowDefinition Height="125"/>
                    <RowDefinition Height="125"/>
                    <RowDefinition Height="125"/>
                    <RowDefinition Height="125"/>
                </Grid.RowDefinitions>


                <!-- ================================= -->
                <!-- COLUNA 1 - ESQUERDA -->
                <!-- 3 SLOTS -->
                <!-- ================================= -->


                <!-- AMULET -->

                <Border Grid.Row="1"
            Grid.Column="0"
            Margin="5"
            Background="#1B1B1B"
            BorderBrush="#353535"
            BorderThickness="1"
            CornerRadius="8">

                    <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                        <TextBlock Text="💎"
                       FontSize="38"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Amulet"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- WEAPON -->

                <Border Grid.Row="2"
            Grid.Column="0"
            Margin="5"
            Background="#1B1B1B"
            BorderBrush="#353535"
            BorderThickness="1"
            CornerRadius="8">

                    <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                        <TextBlock Text="⚔"
                       FontSize="38"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Weapon"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

                        <TextBlock Text="2 ou 3 slots"
                       FontSize="12"
                       Foreground="#888888"
                       HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>


                <!-- RING -->

                <Border Grid.Row="3"
            Grid.Column="0"
            Margin="5"
            Background="#1B1B1B"
            BorderBrush="#353535"
            BorderThickness="1"
            CornerRadius="8">

                    <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                        <TextBlock Text="💍"
                       FontSize="38"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Ring"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ================================= -->
                <!-- COLUNA 2 - CENTRO -->
                <!-- 4 SLOTS -->
                <!-- ================================= -->


                <!-- HELMET -->

                <Border Grid.Row="0"
            Grid.Column="1"
            Margin="5"
            Background="#1B1B1B"
            BorderBrush="#353535"
            BorderThickness="1"
            CornerRadius="8">

                    <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                        <TextBlock Text="⛑"
                       FontSize="38"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Helmet"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

                        <TextBlock Text="2 slots"
                       FontSize="12"
                       Foreground="#888888"
                       HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>


                <!-- ARMOR -->

                <Border Grid.Row="1"
            Grid.Column="1"
            Margin="5"
            Background="#1B1B1B"
            BorderBrush="#353535"
            BorderThickness="1"
            CornerRadius="8">

                    <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                        <TextBlock Text="🛡"
                       FontSize="38"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Armor"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

                        <TextBlock Text="2 ou 3 slots"
                       FontSize="12"
                       Foreground="#888888"
                       HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>


                <!-- LEGS -->

                <Border Grid.Row="2"
            Grid.Column="1"
            Margin="5"
            Background="#1B1B1B"
            BorderBrush="#353535"
            BorderThickness="1"
            CornerRadius="8">

                    <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                        <TextBlock Text="👖"
                       FontSize="38"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Legs"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

                        <TextBlock Text="Sem slot"
                       FontSize="12"
                       Foreground="#888888"
                       HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>


                <!-- BOOTS -->

                <Border Grid.Row="3"
            Grid.Column="1"
            Margin="5"
            Background="#1B1B1B"
            BorderBrush="#353535"
            BorderThickness="1"
            CornerRadius="8">

                    <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                        <TextBlock Text="👢"
                       FontSize="38"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Boots"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

                        <TextBlock Text="1 slot"
                       FontSize="12"
                       Foreground="#888888"
                       HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>


                <!-- ================================= -->
                <!-- COLUNA 3 - DIREITA -->
                <!-- 3 SLOTS -->
                <!-- ================================= -->


                <!-- BACKPACK -->

                <Border Grid.Row="1"
            Grid.Column="2"
            Margin="5"
            Background="#1B1B1B"
            BorderBrush="#353535"
            BorderThickness="1"
            CornerRadius="8">

                    <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                        <TextBlock Text="🎒"
                       FontSize="38"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Backpack"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

                        <TextBlock Text="1 slot"
                       FontSize="12"
                       Foreground="#888888"
                       HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>


                <!-- SHIELD -->

                <Border Grid.Row="2"
            Grid.Column="2"
            Margin="5"
            Background="#1B1B1B"
            BorderBrush="#353535"
            BorderThickness="1"
            CornerRadius="8">

                    <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                        <TextBlock Text="🛡"
                       FontSize="38"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Shield"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

                        <TextBlock Text="1 slot"
                       FontSize="12"
                       Foreground="#888888"
                       HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>


                <!-- TRINKET -->

                <Border Grid.Row="3"
            Grid.Column="2"
            Margin="5"
            Background="#1B1B1B"
            BorderBrush="#353535"
            BorderThickness="1"
            CornerRadius="8">

                    <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                        <TextBlock Text="🪄"
                       FontSize="38"
                       HorizontalAlignment="Center"/>

                        <TextBlock Text="Trinket"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ================================= -->
            <!-- COMPARAÇÃO -->
            <!-- ================================= -->

            <Border Margin="0,30,0,20"
                    Background="#1B1B1B"
                    CornerRadius="10"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Comparação de custos"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Selecione um equipamento para calcular o melhor custo."
                               Foreground="#888888"
                               Margin="0,5,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Page>