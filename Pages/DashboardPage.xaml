<Page x:Class="ADCoins.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#121212">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="30">

            <!-- TÍTULO -->

            <TextBlock Text="Dashboard"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock Text="Converta Tibia Coins e acompanhe seus valores."
                       FontSize="15"
                       Foreground="#888888"
                       Margin="0,8,0,30"/>


            <!-- CARDS -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- CARD 1 -->

                <Border Grid.Column="0"
                        Margin="0,0,10,0"
                        Height="130"
                        Background="#1B1B1B"
                        CornerRadius="10"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Valor de 250 TC"
                                   Foreground="#999999"
                                   FontSize="14"/>

                        <TextBlock x:Name="Valor250TCText"
                                   Text="R$ 0,00"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>


                <!-- CARD 2 -->

                <Border Grid.Column="1"
                        Margin="10,0"
                        Height="130"
                        Background="#1B1B1B"
                        CornerRadius="10"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Valor de 1 TC"
                                   Foreground="#999999"
                                   FontSize="14"/>

                        <TextBlock x:Name="Valor1TCText"
                                   Text="0 GOLD"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>


                <!-- CARD 3 -->

                <Border Grid.Column="2"
                        Margin="10,0,0,0"
                        Height="130"
                        Background="#1B1B1B"
                        CornerRadius="10"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Valor Farmado"
                                   Foreground="#999999"
                                   FontSize="14"/>

                        <TextBlock x:Name="ValorFarmadoText"
                                   Text="0 GOLD"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ====================================== -->
            <!-- CONVERSOR -->
            <!-- ====================================== -->

            <Border Margin="0,25,0,0"
                    Background="#1B1B1B"
                    CornerRadius="10"
                    Padding="25">

                <StackPanel>

                    <TextBlock Text="Conversor"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="Calcule quanto seu farm vale em Tibia Coins e reais."
                               Foreground="#888888"
                               Margin="0,5,0,20"/>


                    <!-- CAMPOS -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <!-- 250 TC -->

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,10,0">

                            <TextBlock Text="Valor de 250 TC em R$"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,8"/>

                            <TextBox x:Name="Valor250TCInput"
                                     Height="40"
                                     Background="#252525"
                                     Foreground="White"
                                     BorderBrush="#3A3A3A"
                                     Padding="10"
                                     Text="57,00"/>

                        </StackPanel>


                        <!-- TC GOLD -->

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">

                            <TextBlock Text="Valor de 1 TC em GOLD"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,8"/>

                            <TextBox x:Name="ValorTCGoldInput"
                                     Height="40"
                                     Background="#252525"
                                     Foreground="White"
                                     BorderBrush="#3A3A3A"
                                     Padding="10"
                                     Text="37000"/>

                        </StackPanel>

                    </Grid>


                    <!-- FARM -->

                    <TextBlock Text="Valor Farmado"
                               Foreground="#CCCCCC"
                               Margin="0,20,0,8"/>

                    <TextBox x:Name="ValorFarmadoInput"
                             Height="40"
                             Background="#252525"
                             Foreground="White"
                             BorderBrush="#3A3A3A"
                             Padding="10"
                             Text="0"/>


                    <!-- BOTÃO -->

                    <Button Content="CALCULAR"
                            Height="45"
                            Margin="0,20,0,0"
                            Background="#292929"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Click="CalcularButton_Click"/>


                    <!-- ========================================= -->
                    <!-- RESULTADO -->
                    <!-- ========================================= -->

                    <Border Margin="0,25,0,0"
        Background="#1B1B1B"
        CornerRadius="10"
        Padding="25">

                        <StackPanel>

                            <TextBlock Text="Resultado"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="White"/>

                            <TextBlock Text="Resultado da conversão"
                   Foreground="#888888"
                   Margin="0,5,0,20"/>


                            <!-- VALORES DO RESULTADO -->

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- TC OBTIDAS -->

                                <StackPanel Grid.Column="0"
                        Margin="0,0,10,0">

                                    <TextBlock Text="TC Obtidas"
                           Foreground="#888888"
                           FontSize="14"/>

                                    <TextBlock x:Name="ResultadoTCText"
                           Text="0,00 TC"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,5,0,0"/>

                                </StackPanel>


                                <!-- VALOR EM REAIS -->

                                <StackPanel Grid.Column="1"
                        Margin="10,0,0,0">

                                    <TextBlock Text="Valor do Farm em R$"
                           Foreground="#888888"
                           FontSize="14"/>

                                    <TextBlock x:Name="ResultadoReaisText"
                           Text="R$ 0,00"
                           Foreground="LightGreen"
                           FontSize="26"
                           FontWeight="Bold"
                           Margin="0,5,0,0"/>

                                </StackPanel>

                            </Grid>


                            <!-- BOTÃO COPIAR -->

                            <Button Content="📋 COPIAR RESULTADO"
                Height="40"
                Margin="0,20,0,0"
                Background="#292929"
                Foreground="White"
                BorderThickness="0"
                FontWeight="Bold"
                Click="CopiarResultadoButton_Click"/>

                        </StackPanel>

                    </Border>
                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Page>